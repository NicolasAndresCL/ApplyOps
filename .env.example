# Copiar a .env y completar. .env está en .gitignore: nunca se versiona.

# Base de datos (SQLAlchemy + psycopg 3). En Docker Compose el host es "db".
DATABASE_URL=postgresql+psycopg://applyops:cambiar-esta-clave@localhost:5433/applyops
POSTGRES_PASSWORD=cambiar-esta-clave

# Puertos del host en Docker Compose (5433 para no chocar con un PostgreSQL local)
DB_PUERTO_HOST=5433
API_PUERTO_HOST=8000

# Criterios de búsqueda y scoring. Si no existe, se usa perfil/busqueda.example.yaml.
PERFIL_BUSQUEDA_PATH=perfil/busqueda.yaml

# Recolección automática (horas entre ciclos; 0 = solo manual por POST /recolecciones)
RECOLECCION_INTERVALO_HORAS=0

# Red hacia las fuentes
HTTP_TIMEOUT_SEGUNDOS=15
HTTP_REINTENTOS=3

# Get on Board (API pública, sin credenciales)
GETONBOARD_URL_BASE=https://www.getonbrd.com/api/v0
GETONBOARD_MAX_PAGINAS=4

# UI (NiceGUI). Generar el secreto con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_URL=http://127.0.0.1:8000
UI_PUERTO=8080
UI_PUERTO_HOST=8080
UI_STORAGE_SECRET=
TEMAS_ASSETS_DIR=assets/temas

# Nivel de logs (DEBUG, INFO, WARNING)
LOG_LEVEL=INFO
